{
    "site_title": "AICMS",
    "site_description": "Простая и быстрая CMS",
    "site_keywords": "",
    "favicon": "\/assets\/img\/favicon.ico",
    "theme": "sity1",
    "languages": [
        {
            "code": "ru",
            "name": "Русский"
        },
        {
            "code": "en",
            "name": "English"
        }
    ],
    "default_lang": "ru",
    "show_news": true,
    "clean_urls": false,
    "features": {
        "2fa": false,
        "csp_headers": false,
        "webp_conversion": false,
        "ai_translation": false,
        "telegram_bot": false,
        "webhooks": false,
        "rest_api": false
    },
    "extensions": {
        "shop": {
            "enabled": true,
            "title": "Магазин"
        },
        "comments": {
            "enabled": true,
            "title": "Комментарии"
        },
        "forum": {
            "enabled": true,
            "title": "Форум"
        },
        "booking": {
            "enabled": true,
            "title": "Бронирование"
        }
    },
    "storage": {
        "driver": "mysql",
        "host": "",
        "port": "3306",
        "database": "",
        "username": "",
        "password": "",
        "prefix": "aicms_",
        "path": "data\/aicms.db"
    },
    "ai": {
        "text": {
            "provider": "openrouter",
            "model": "mistralai\/mistral-7b-instruct:free",
            "api_key": ""
        },
        "image": {
            "provider": "pollinations",
            "model": "flux",
            "api_key": ""
        },
        "video": {
            "provider": "disabled",
            "model": "",
            "api_key": ""
        }
    },
    "onboarding_complete": true,
    "_secrets_moved_to": "data\/.env.php"
}
