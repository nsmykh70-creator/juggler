# Disable browser caching for Lumina editor JS files.
# ES modules are cached aggressively by browsers; this ensures the latest
# versions are always served. The ?v= query params on imports also help,
# but this header provides a server-side guarantee for Apache installations.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Also disable ETag-based caching for these files
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None
